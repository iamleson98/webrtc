# Generated by Cargo
# will have compiled files and executables
/target/
/.idea/
/crates/target/
/crates/.idea/

# These are backup files generated by rustfmt
**/*.rs.bk
**/.DS_Store

# Editor configs
Cargo.lock

# Written by interop/run.sh
/interop/interop-results.log

# compare/: build outputs; the Rust lockfile is kept (it is a binary), the root rule above is for libraries
compare/**/target/
compare/harness/browser/.entry.ts
!/compare/rtcd-rust/Cargo.lock
